# Copy to .env for local development (never commit .env).

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/manyplug

# Public origin of the hub (in production: https://...). Render sets RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=http://localhost:3000
# Former public origins (comma separated) that redirect to PUBLIC_URL. RENDER_EXTERNAL_URL is included automatically.
# LEGACY_PUBLIC_URLS=https://old.example.com
PORT=3000

# 32-byte key that encrypts service credentials at rest. Generate: npm run cli -- keys:generate
# Losing it means losing access to stored credentials. Optional in development (an insecure dev key is used).
ENCRYPTION_KEY=
# Previous keys (comma separated) after a rotation, so old data stays readable.
ENCRYPTION_KEYS_PREVIOUS=

# The owner account, created on first start. Changing ADMIN_PASSWORD and restarting resets the password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# --- Website: sign-up, admin panel --------------------------------------------------------
# "Sign in with Google". Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URIs: <PUBLIC_URL>/auth/google/callback (sign-in) and <PUBLIC_URL>/connect/callback
# (connecting Gmail/Calendar/Drive accounts). Falls back to OAUTH_APP_GOOGLE_CLIENT_ID / _SECRET, and
# connecting Google services uses this client too unless OAUTH_APP_GOOGLE_* are set.
# LOGIN_GOOGLE_CLIENT_ID=
# LOGIN_GOOGLE_CLIENT_SECRET=
# The hub's own OAuth apps for connecting services: OAUTH_APP_<SERVICE>_CLIENT_ID / _CLIENT_SECRET
# OAUTH_APP_GOOGLE_CLIENT_ID=
# OAUTH_APP_GOOGLE_CLIENT_SECRET=
# open = anyone can sign up; closed = only existing users (and ADMIN_EMAILS) can sign in
# SIGNUPS=open
# More administrators (comma separated). Through Google only Gmail or Google Workspace addresses
# of their own domain count, so nobody can claim an admin address with another provider.
# ADMIN_EMAILS=
# The admin panel only from these addresses or networks (comma separated, e.g. 203.0.113.7,10.0.0.0/8)
# ADMIN_ALLOWED_IPS=
# How long an admin sign-in stays fresh for the panel (hours; then sign in again with the second factor)
# ADMIN_SESSION_HOURS=8
# Shown on the pricing, billing and legal pages for plan requests and questions
# SUPPORT_EMAIL=
# Proxies in front of the hub whose X-Forwarded-For entries are trusted (Render: 2 = Cloudflare +
# Render's balancer, set automatically on Render). true = 1, false = 0.
# TRUST_PROXY=2
# Or take the client IP from one header your platform sets (e.g. CF-Connecting-IP)
# CLIENT_IP_HEADER=

LOG_LEVEL=info
# MIGRATE_ON_START=true
# SEED_DEMO_ACCOUNTS=true
# OAUTH_DYNAMIC_REGISTRATION=true
# OAUTH_CLIENT_METADATA_DOCUMENTS=true
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_DAYS=90
# SESSION_TTL_DAYS=30
# TOOL_TIMEOUT_SECONDS=120
# Size budget of one tool result in tokens; larger results are trimmed with a note
# TOOL_RESULT_MAX_TOKENS=2000
# Identical writes within this window are not repeated (duplicate protection); 0 disables
# IDEMPOTENCY_WINDOW_SECONDS=300
# Token budget of the tool list; above it the hub switches to search/call meta tools (auto listing)
# TOOL_LIST_TOKEN_BUDGET=3000
# Require every user to set up a second factor (authenticator app or passkey) before using the hub.
# REQUIRE_2FA=false

# --- Confirmations of risky actions ---------------------------------------------------------
# The hub's own Telegram bot (create one with @BotFather): confirmation buttons in Telegram.
# Needs an https PUBLIC_URL (Telegram delivers button presses to /telegram/webhook).
# TELEGRAM_BOT_TOKEN=
# How long a call waits for the user's answer before telling the AI it is still pending
# CONFIRMATION_WAIT_SECONDS=40
# How long an unanswered confirmation stays valid
# CONFIRMATION_TTL_MINUTES=30

# AI apps may connect to /mcp before signing in: they see the services and the connect tool, and
# the first call that needs an account starts sign-in (401). Requests per minute per IP without sign-in.
# MCP_ANONYMOUS=false
# MCP_ANONYMOUS_RATE_LIMIT=30

# --- AI app directories (docs/DIRECTORIES.md) -------------------------------------------------------
# Directory rules enforced for clients of those apps: claude, chatgpt (comma separated) or none.
# CLIENT_POLICIES=claude
# Sign-in for directory reviewers (password, no second factor, demo accounts, unlimited plan).
# REVIEW_ACCOUNT_EMAIL=
# REVIEW_ACCOUNT_PASSWORD=
# Ownership proofs: WELL_KNOWN_<NAME> is served as plain text at /.well-known/<name>.
# WELL_KNOWN_MCP_REGISTRY_AUTH=v=MCPv1; k=ed25519; p=...
# WELL_KNOWN_OPENAI_APPS_CHALLENGE=

# --- Payments (docs/BILLING.md) ----------------------------------------------------------------
# none (plans are set by an admin on request), paddle, stripe, or test (development only)
# BILLING_PROVIDER=none
# Paddle: sandbox until checked, then production keys
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_PERSONAL_MONTH=pri_...
# PADDLE_PRICE_PERSONAL_YEAR=pri_...
# PADDLE_PRICE_PRO_MONTH=pri_...
# PADDLE_PRICE_PRO_YEAR=pri_...
# PADDLE_PRICE_BUSINESS_MONTH=pri_...
# PADDLE_PRICE_BUSINESS_YEAR=pri_...
# Stripe (prices: STRIPE_PRICE_<PLAN>_<MONTH|YEAR>=price_...)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
